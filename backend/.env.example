# Backend
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
MAX_URL_FETCH_SIZE=5242880
URL_FETCH_TIMEOUT=15000
MAX_PDF_SIZE=10485760
RATE_LIMIT_ANONYMOUS=20
RATE_LIMIT_API_KEY=200
RATE_LIMIT_WINDOW_MS=3600000
DB_PATH=./data/mekdara.db

# Auth (Better Auth + Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=your_base64_secret_here
BETTER_AUTH_URL=http://localhost:8080

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email (SMTP — Resend, Mailgun, etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_api_key
EMAIL_FROM=Mekdara <noreply@yourdomain.com>

# Telemetry (disabled by default)
BETTER_AUTH_TELEMETRY=0
